geom_boxplot() +
geom_hline(yintercept = 0.16, linetype = "dotted") +
expand_limits(y=c(0, 0.2)) +
scale_x_discrete(limits = rev) +
scale_y_continuous(n.breaks=6) +
xlab("") + ylab("") +
